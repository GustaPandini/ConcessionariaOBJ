<?xml version="1.0" encoding="utf-8" ?>
<!-- String de conexão com o banco MySQL local -->
<!-- crie um novo item App.config, cole esse código de exemplo e adicione a sua senha do banco na connectionString -->
<configuration>
	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Server=localhost;Database=concessionaria;Uid=appuser;Pwd=;"
			 providerName="MySql.Data.MySqlClient"/>
	</connectionStrings>
</configuration>


<!--
Digite a sua senha novamente nesse SQL abaixo e rode ele no MySql Workbench antes de iniciar o sistema! 

CREATE USER 'appuser'@'localhost' IDENTIFIED BY 'SUA_SENHA';
GRANT ALL PRIVILEGES ON concesionaria.* TO 'appuser'@'localhost';
FLUSH PRIVILEGES;
-->
