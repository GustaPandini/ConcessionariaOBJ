<?xml version="1.0" encoding="utf-8" ?>
<!-- String de conexão com o banco MySQL local -->
<!-- crie um novo item App.config, cole esse código de exemplo e adicione a sua senha do banco na connectionString -->
<configuration>
	<connectionStrings>
		<add name="DefaultConnection"
			 connectionString="Server=localhost;Database=concesionaria;Uid=root;Pwd=;"
			 providerName="MySql.Data.MySqlClient"/>
	</connectionStrings>
</configuration>
